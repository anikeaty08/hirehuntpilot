# hirehuntpilot non-secret config example
#
# API keys are stored encrypted by `hirehuntpilot init` in the app secrets store.
# Keep this file for non-secret overrides only.

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Local OpenAI-compatible model example
# LLM_PROVIDER=local
# LLM_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=llama3.1:8b

# Optional browser/apply config
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional network config
# PROXY=host:port:user:pass
